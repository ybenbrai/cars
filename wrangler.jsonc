{
  // Cloudflare Workers deployment: serve the prebuilt static game from dist/.
  // This is a static-only site; there is no server-side API or Durable Object.
  // Build with `npm run build` before deploying.
  "name": "sunset-drift",
  "compatibility_date": "2026-11-12",
  "assets": {
    "directory": "./dist"
  }
}
